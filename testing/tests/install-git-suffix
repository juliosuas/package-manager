@TEST-START-FILE legacy-manifest.sh
#!/bin/bash
set -e
python3 - <<'PY'
import json
import os

with open("state/manifest.json") as manifest_file:
    data = json.load(manifest_file)

renamed = False
for item in data["installed_packages"]:
    if item["package_dict"].get("name") == "log4j":
        item["package_dict"]["name"] = "log4j.git"
        renamed = True

if not renamed:
    raise SystemExit("log4j is not installed")

with open("state/manifest.json", "w") as manifest_file:
    json.dump(data, manifest_file)

for base in ("state/clones/package", "scripts/packages", "plugins/packages"):
    src = os.path.join(base, "log4j")
    dst = os.path.join(base, "log4j.git")
    if os.path.isdir(src):
        os.rename(src, dst)

link = "scripts/log4j"
if os.path.islink(link):
    os.remove(link)
PY
@TEST-END-FILE
