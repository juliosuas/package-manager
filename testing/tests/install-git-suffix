set -e

cp -R packages/foo packages/log4j.git
printf 'print "log4j loaded";\n' > packages/log4j.git/__load__.zeek
(
    cd packages/log4j.git &&
    git add __load__.zeek &&
    git commit -m 'log4j'
)

echo "$(pwd)/packages/log4j.git" >> sources/one/alice/zkg.index
(
    cd sources/one &&
    git add alice/zkg.index &&
    git commit -m 'add log4j.git'
)

